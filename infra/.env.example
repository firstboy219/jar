# Copy to .env (or run ./scripts/init-env.sh, which generates the random secrets).
# NEVER commit .env.

TZ=Asia/Jakarta
HOST_UID=1000
HOST_GID=1000

# Domains (Nginx Proxy Manager proxy hosts)
FRONTEND_DOMAIN=jar1.cosger.online
BACKEND_DOMAIN=vis1.cosger.online
FLOW_DOMAIN=flow1.cosger.online

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
# Must support tool calling. BRD's hermes-3-llama-3.1-70b does not on OpenRouter.
JARVIS_DEFAULT_MODEL=deepseek/deepseek-v4-flash
JARVIS_CODER_MODEL=qwen/qwen3-coder-next
# Tier 3: stronger model Hermes delegates to when it decides it needs more capability
JARVIS_EXPERT_MODEL=deepseek/deepseek-v4-pro

# --- Hermes API (bearer token clients use to talk to the agent) ---
HERMES_API_KEY=

# --- Postgres ---
POSTGRES_USER=jarvis_admin
POSTGRES_PASSWORD=
# jarvis-core's own least-privilege DB role
JARVIS_DB_PASSWORD=

# --- n8n ---
N8N_ENCRYPTION_KEY=
# Create in n8n UI (Settings -> n8n API) after first login, then paste here
N8N_API_KEY=

# --- Qdrant ---
QDRANT_API_KEY=

# --- jarvis-core ---
# web admin -> core (internal), Hermes -> jarvis-tools (MCP)
CORE_ADMIN_TOKEN=
MCP_TOKEN=
# Voice (FS-101): APK gets short-lived tokens from core; fill from the web admin
DEEPGRAM_API_KEY=

# --- Nginx Proxy Manager admin (127.0.0.1:81, used by scripts/npm-proxy-hosts.sh) ---
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=

# --- Web admin (generated by init-env.sh; change password in the UI) ---
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
