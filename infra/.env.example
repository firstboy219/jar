# Copy to .env (or run ./scripts/init-env.sh, which generates the random secrets).
# NEVER commit .env.

TZ=Asia/Jakarta
HOST_UID=1000
HOST_GID=1000

# Domains (Nginx Proxy Manager proxy hosts)
FRONTEND_DOMAIN=jar1.cosger.online
BACKEND_DOMAIN=vis1.cosger.online
FLOW_DOMAIN=flow1.cosger.online

# --- AI (ADR-017) ---
# Default composition is fully LOCAL (Qwen on this server, Whisper): JARVIS works with no key at all.
# Which AI handles each category is chosen in the APK (Komposisi AI); cloud keys below only make
# options available. A missing key = that provider is skipped and the local model answers.
OPENROUTER_API_KEY=
# Optional per-component OpenRouter keys (set a monthly limit on each at openrouter.ai/settings/keys);
# empty = OPENROUTER_API_KEY is used
OPENROUTER_KEY_CHAT=
OPENROUTER_KEY_HERMES=
OPENROUTER_KEY_LATAR=
# Groq: fast Whisper speech recognition (free tier ~8 h audio/day)
GROQ_API_KEY=
# Maps: routes with live traffic (TomTom, free 2,500/day) / alternatives (OpenRouteService, free 2,000/day);
# without keys the public OSRM demo is used (no traffic)
TOMTOM_API_KEY=
ORS_API_KEY=
# Soft monthly AI budget (USD) enforced by jarvis-core; hard caps live on the providers' sites
JARVIS_BUDGET_USD=20
# Hermes -> jarvis-core LLM gateway (internal)
LLM_GATEWAY_KEY=
# Password manager encryption key (AES-256, hex); losing it makes saved passwords unreadable — it is in the backups
VAULT_KEY=
# Worker tasks queue without limit; this many run at the same time
WORKER_CONCURRENCY=6
# Notifications: only urgent ones are spoken in these hours (WIB); empty = never quiet
QUIET_HOURS=22:00-06:00
# Local speech models (jarvis-ears): small = ~3.5 s/utterance, WER ~19%; large-v3-turbo = WER ~10% but ~3x real time
WHISPER_LIVE_MODEL=small
WHISPER_FILE_MODEL=small

# --- Hermes API (bearer token clients use to talk to the agent) ---
HERMES_API_KEY=

# --- Off-site backup (scripts/backup.sh): rclone remote, e.g. gdrive:jarvis-backup; needs backups/rclone.conf + backups/age-recipients.txt ---
BACKUP_REMOTE=

# --- Postgres ---
POSTGRES_USER=jarvis_admin
POSTGRES_PASSWORD=
# jarvis-core's own least-privilege DB role
JARVIS_DB_PASSWORD=
# read-only role for Hermes' db_query_ro tool (BR-003)
JARVIS_RO_PASSWORD=

# --- n8n ---
N8N_ENCRYPTION_KEY=
# Create in n8n UI (Settings -> n8n API) after first login, then paste here
N8N_API_KEY=

# --- Qdrant ---
QDRANT_API_KEY=

# --- jarvis-core ---
# web admin -> core (internal), Hermes -> jarvis-tools (MCP)
CORE_ADMIN_TOKEN=
MCP_TOKEN=
# Voice (FS-101): APK gets short-lived tokens from core; fill from the web admin
DEEPGRAM_API_KEY=
# Speech-to-text: nova-2 benchmarked best for Indonesian (see docs/decisions.md ADR-011)
DEEPGRAM_MODEL=nova-2
# Names/terms the recogniser should favour (comma-separated)
DEEPGRAM_KEYWORDS=JARVIS,Autotoko,n8n,UAT,BRD,FSD,workflow,Shopee,Tokopedia

# --- Nginx Proxy Manager admin (127.0.0.1:81, used by scripts/npm-proxy-hosts.sh) ---
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=

# --- Web admin (generated by init-env.sh; change password in the UI) ---
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Android release signing (keystore: infra/data/android/release.keystore; BACK IT UP) ---
ANDROID_KEYSTORE_PASSWORD=
