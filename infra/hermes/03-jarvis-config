#!/command/with-contenv sh
# Mounted into /etc/cont-init.d/ by docker-compose.yml. Runs as root on every container start
# (after 01-hermes-setup seeds $HERMES_HOME) and makes config.yaml follow JARVIS (ADR-017/018):
#   providers.jarvis  every model call goes through jarvis-core's LLM gateway (/llm/v1): the owner's
#                     composition picks the AI per category, fails over, and falls back to the local model
#   model / routes    default category 'web'; jarvis-<category> aliases for tasks, delegation, cron, vision
#   memory            Hermes' own memory ON, mirrored into JARVIS' one memory by the jarvis-memory plugin
#   toolsets          everything the API server can use, plus kanban, tts, video, project, debugging
#   mcp_servers       jarvis-tools (memory, the owner, the phone's screen, documents, approvals, n8n, BR-003)
#   HERMES_PROFILE    lean (default while Hermes runs on the local CPU, ADR-031): heavy tools deferred behind
#                     tool_search, only JARVIS' own skills in the prompt, side tasks on the chat model, one
#                     sub-agent at a time — measured 22.6k → ~10k prompt tokens. full: everything eager (cloud).
# Hermes decides its own flow (tools, skills, sub-agents, schedules). What stays fixed are the owner's
# safety rules: approvals for dangerous actions (bridged to the phone), no credentials for n8n/DB/admin,
# web content is data, budget enforced by the gateway.
set -e
cd /opt/hermes
s6-setuidgid hermes /opt/hermes/.venv/bin/python - <<'PY'
import os
import hermes_yaml as yaml  # Hermes' own ruamel wrapper (no PyYAML in the image)
path = os.path.join(os.environ.get("HERMES_HOME", "/opt/data"), "config.yaml")
with open(path) as f:
    cfg = yaml.safe_load(f) or {}

env = os.environ.get
GATEWAY = "http://jarvis-core:8000/llm/v1"
CATEGORIES = ["web", "coding", "produktivitas", "analisis", "latar-belakang", "privat", "penglihatan", "cepat"]

# --- every model call → JARVIS' LLM gateway ---
providers = cfg.get("providers") if isinstance(cfg.get("providers"), dict) else {}
providers["jarvis"] = {"name": "jarvis", "base_url": GATEWAY, "key_env": "LLM_GATEWAY_KEY",
                       "api_mode": "chat_completions", "default_model": "jarvis-web"}
cfg["providers"] = providers
cfg["model"] = {"provider": "jarvis", "default": "jarvis-web", "base_url": GATEWAY,
                # what the gateway advertises; Hermes needs >= 64k, and the window bounds cost too
                "context_length": 65536, "max_tokens": 8192}
overrides = cfg.get("model_overrides") if isinstance(cfg.get("model_overrides"), dict) else {}
overrides["custom:jarvis"] = {"_default": {"context_window": 65536, "supports_tools": True, "supports_vision": True}}
cfg["model_overrides"] = overrides
cfg.setdefault("agent", {})["reasoning_effort"] = "low"

# Per-task category: core starts each run with model "jarvis-<category>" (api_server.model_routes).
platforms = cfg.setdefault("platforms", {}) if isinstance(cfg.get("platforms"), dict) or cfg.get("platforms") is None else {}
cfg["platforms"] = platforms
api = platforms.setdefault("api_server", {})
api["enabled"] = True
extra = api.setdefault("extra", {})
extra["model_routes"] = {f"jarvis-{c}": {"model": f"jarvis-{c}", "provider": "jarvis", "base_url": GATEWAY}
                         for c in CATEGORIES}

# --- freedom: Hermes chooses its own flow ---
agent = cfg.setdefault("agent", {})
agent["max_turns"] = 90
agent.pop("disabled_toolsets", None)
delegation = cfg.setdefault("delegation", {})
delegation.update({"model": "jarvis-analisis", "provider": "jarvis", "base_url": GATEWAY,
                   "max_concurrent_children": 4, "child_timeout_seconds": 1800,  # a hung child must not hang the task
                   "subagent_auto_approve": False})
cron = cfg.setdefault("cron", {})
cron.update({"model": "jarvis-latar-belakang", "model_provider": "jarvis",
             "allow_agent_scheduling": True})  # Hermes may schedule its own jobs (results via notify_owner)
# Every auxiliary model task (vision, compression, approval guardian, curator, titles, kanban, …) goes
# through the gateway too: nothing bypasses the owner's composition and budget.
from hermes_cli.config_defaults import DEFAULT_CONFIG
AUX_CATEGORY = {"vision": "penglihatan", "compression": "latar-belakang", "curator": "latar-belakang",
                "background_review": "latar-belakang", "kanban_decomposer": "analisis", "goal_judge": "analisis",
                "moa_reference": "analisis", "moa_aggregator": "analisis"}
aux = cfg.setdefault("auxiliary", {})
for task, default in DEFAULT_CONFIG["auxiliary"].items():
    if isinstance(default, dict) and "provider" in default:
        cur = aux.get(task) if isinstance(aux.get(task), dict) else {}
        aux[task] = {**cur, "provider": "jarvis", "model": f"jarvis-{AUX_CATEGORY.get(task, 'cepat')}", "base_url": GATEWAY}

pt = cfg.get("platform_toolsets") if isinstance(cfg.get("platform_toolsets"), dict) else {}
pt["api_server"] = ["hermes-api-server", "kanban", "tts", "video", "project", "debugging", "todo"]
cfg["platform_toolsets"] = pt

# --- prompt size (ADR-031). Measured 2026-10-21: of ~22.6k prompt tokens per step, 16.4k were tool schemas
# (kanban alone 6.1k) and 3.4k the index of 149 skills; the local CPU reads ~10–17 tokens/s.
PROFILE = (env("HERMES_PROFILE") or "lean").strip().lower()
LEAN_DEFER = {"kanban_create", "kanban_complete", "kanban_request_review", "kanban_block", "kanban_attach",
              "kanban_list", "kanban_attach_url", "kanban_show", "kanban_request_changes", "kanban_heartbeat",
              "kanban_comment", "kanban_attachments", "kanban_link", "kanban_unblock", "manage_connections",
              "delegate_task", "skill_manage", "browser_exec", "text_to_speech"}
ts = cfg.setdefault("tools", {}).setdefault("tool_search", {})
default_defer = set(DEFAULT_CONFIG["tools"]["tool_search"]["defer"])
skills_root = os.path.join(os.environ.get("HERMES_HOME", "/opt/data"), "skills")
if PROFILE == "lean":
    # The local CPU reads a cold prompt for minutes before the first byte; Hermes treats the gateway as a cloud
    # provider (180 s patience, retried 5× then "consecutive stale attempts" — seen 2026-10-21): wait instead.
    providers["jarvis"]["stale_timeout_seconds"] = 2700
    ts["enabled"] = True
    ts["defer"] = sorted(default_defer | LEAN_DEFER)  # still usable: tool_search loads a schema when needed
    delegation["max_concurrent_children"] = 1  # one CPU: parallel children only queue up
    for task, entry in aux.items():  # side tasks on the chat model (its own server), not the work model
        if isinstance(entry, dict) and entry.get("provider") == "jarvis" and task != "vision":
            entry["model"] = "jarvis-cepat"
    hidden = []
    for root, _, files in os.walk(skills_root):
        if "SKILL.md" in files and not os.path.relpath(root, skills_root).split(os.sep)[0].startswith("jarvis"):  # jarvis + jarvis-learned
            for line in open(os.path.join(root, "SKILL.md"), errors="replace").read().splitlines()[:15]:
                if line.startswith("name:"):
                    hidden.append(line.split(":", 1)[1].strip().strip('"\''))
                    break
    cfg.setdefault("skills", {})["disabled"] = sorted(set(hidden))  # only JARVIS' own skills in the prompt
else:
    providers["jarvis"].pop("stale_timeout_seconds", None)
    ts["defer"] = sorted(default_defer)
    cfg.setdefault("skills", {})["disabled"] = []

# Memory: Hermes' own memory on, mirrored into JARVIS' shared memory (plugin infra/hermes/plugins/jarvis-memory).
mem = cfg.setdefault("memory", {})
mem.update({"memory_enabled": True, "user_profile_enabled": True, "nudge_interval": 10, "provider": "jarvis-memory"})
plugins = cfg.setdefault("plugins", {}) if isinstance(cfg.get("plugins"), dict) else {}
enabled = plugins.get("enabled") if isinstance(plugins.get("enabled"), list) else []
if "jarvis-memory" not in enabled:
    enabled.append("jarvis-memory")
plugins["enabled"] = enabled
cfg["plugins"] = plugins

# Skills: Hermes may write and improve its own skills; self-made ones are scanned before use.
skills = cfg.setdefault("skills", {})
skills["guard_agent_created"] = True

# --- the owner's safety rules (knowledge base), not flow control ---
approvals = cfg.setdefault("approvals", {})
approvals.update({"mode": "smart", "timeout": 1800,  # the owner answers from the phone; give them time
                  "smart_policy": "ESCALATE anything that sends messages/emails/posts, spends money, deletes data, "
                                  "or changes production systems, DNS, firewall or the host."})
cfg.setdefault("tool_loop_guardrails", {})["hard_stop_enabled"] = True
cfg.setdefault("prompt_caching", {})["cache_ttl"] = "5m"

servers = cfg.get("mcp_servers") or {}
if env("MCP_TOKEN"):
    servers["jarvis"] = {"url": "http://jarvis-tools:8100/mcp", "timeout": 330,
                         "headers": {"Authorization": "Bearer " + env("MCP_TOKEN")}}
cfg["mcp_servers"] = servers

with open(path, "w") as f:
    yaml.safe_dump(cfg, f, sort_keys=False)
print(f"[jarvis] gateway={GATEWAY} routes={len(extra['model_routes'])} memory={mem['provider']} mcp={list(servers)} "
      f"profile={PROFILE} deferred={len(ts['defer'])} skills_hidden={len(cfg['skills']['disabled'])}")
PY
